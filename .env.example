# Copy to .env and fill in. Never commit .env — it is gitignored.
# Notebooks, scripts and the FastAPI service load it automatically via python-dotenv.

# Required by almost everything. Models (nvidia/nemotron-3-super-120b-a12b, nvidia/nemotron-3-embed-1b)
# are served from NVIDIA NIM's OpenAI-compatible endpoint. Get a key at https://build.nvidia.com
NVIDIA_API_KEY=

# Required only by the escalation agent with Langfuse observability
# (notebooks/agents/escalation_agent_langgraph_with_langfuse_observability.ipynb)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
