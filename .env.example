# Copy to .env and fill in. Never commit .env — it is gitignored.
# Notebooks, scripts and the FastAPI service load it automatically via python-dotenv
# (older scripts) or src/ai_engineering/config.py (newer scripts, pydantic-settings).

# Which OpenAI-compatible provider src/ai_engineering/config.py points at:
# nvidia (default) or openai. Provider-specific request fields (NIM's thinking
# switch, embedding input_type) are only sent to the provider that accepts them.
LLM_PROVIDER=nvidia

# Optional overrides — leave unset to use the selected provider's default
# (nvidia/nemotron-3-super-120b-a12b + nvidia/nemotron-3-embed-1b for nvidia,
# gpt-4o-mini + text-embedding-3-small for openai). Set these to point at a
# different deployment or model without touching any notebook.
LLM_BASE_URL=
LLM_MODEL=
EMBEDDING_MODEL=

# Optional client-side pacing (requests/minute) shared by every client in a
# process. The eval notebooks default to 30 to stay under NIM's free-tier limit.
LLM_MAX_RPM=

# Optional USD prices per million prompt / completion tokens. Set both to cap
# agent runs by cost (agent_reliability_hardening); unset = cost not capped.
LLM_USD_PER_MTOK_IN=
LLM_USD_PER_MTOK_OUT=

# Required when LLM_PROVIDER=nvidia (the default — almost everything in this
# repo). Models are served from NVIDIA NIM's OpenAI-compatible endpoint.
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=

# Required only when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# Required only by the escalation agent with Langfuse observability
# (notebooks/agents/escalation_agent_langgraph_with_langfuse_observability.ipynb)
# and notebooks/agents/agent_observability_eval.ipynb. Without these, that
# notebook keeps its local in-process trace only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
